module Binpacker
  class Timing
    def initialize: (untyped) -> void
    DEFAULT_WEIGHT: Float
    MAX_SAMPLES_PER_TEST: Integer
    SPEED_FACTOR_MIN_FILE_WEIGHT: Float
    SPEED_FACTOR_MIN_FILES: Integer
    def calibrated?: () -> bool
    def load_with_fallback: (untyped) -> Hash[untyped, Float]
    def load_raw: () -> (Hash[[String, untyped], untyped] | {})
    def load_per_file: () -> (Hash[String, untyped] | {})
    def normalize_path: (untyped) -> String
    def measured?: (file: untyped, name: untyped) -> bool
    def compact!: () -> void
    def speed_factor: (Array[Hash[Symbol, untyped]]) -> Float?
    def samples: () -> Hash[[String, untyped], Array[Float]]
    def write_samples: (Hash[[String, untyped], Array[Float]]) -> void
    def append_all: (untyped) -> nil
    class Entry
    end
  end
end
